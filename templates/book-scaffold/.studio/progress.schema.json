{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonfiction-studio.dev/schemas/progress-2.json",
  "title": "Nonfiction Studio progress.json",
  "type": "object",
  "required": ["version", "updated", "chapters", "totals"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "const": 2,
      "description": "Bible schema major; must equal meta.json schema_version."
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC of the last atomic write."
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "status", "word_count", "open_claim_count"],
        "additionalProperties": true,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[0-9]{2}-[a-z0-9-]+$",
            "description": "Two-digit ordinal plus kebab title, matches the chapter filename stem."
          },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["empty", "outlined", "drafting", "drafted", "revised", "gated", "final"]
          },
          "word_count": { "type": "integer", "minimum": 0 },
          "drift_score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100,
            "description": "Deterministic stylometric distance from baseline (D-08); null until first scored."
          },
          "open_claim_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of factual markers not yet resolved to a verified ledger entry."
          },
          "last_gate": {
            "type": ["object", "null"],
            "required": ["ts", "verdict"],
            "additionalProperties": true,
            "properties": {
              "ts": { "type": "string", "format": "date-time" },
              "verdict": {
                "type": "string",
                "enum": ["pass", "warn", "block", "skip"]
              },
              "report": {
                "type": "string",
                "description": "Relative path of the gate report under .studio/gate/."
              }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["word_count", "open_claim_count", "chapters_final"],
      "additionalProperties": true,
      "properties": {
        "word_count": { "type": "integer", "minimum": 0 },
        "open_claim_count": { "type": "integer", "minimum": 0 },
        "chapters_final": { "type": "integer", "minimum": 0 },
        "chapters_total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
