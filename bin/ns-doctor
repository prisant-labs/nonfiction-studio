#!/usr/bin/env node
// what-it-is:   the ns-doctor bible integrity CLI (thin shell over hooks/lib/doctor-engine.mjs)
// what-it-does: parses arguments, locates the book root, invokes the doctor engine,
//               and emits a full bible health report; exits 0 when clean, 1 with findings,
//               2 on operational error or migration-required schema version
// why:          the CLI is the public surface; all logic lives in doctor-engine.mjs so tests
//               can drive the engine directly without CLI overhead per S-07 section 4
// usage:        ns-doctor [--check | --migrate | --report] [--project=<dir>]
//                         [--validate-packs] [--json]
//               ns-doctor --adopt-plan [--chapters-dir=<name>] [--project=<dir>] [--json]

import { existsSync, statSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { spawnSync } from 'node:child_process';
import { parseArgs, ArgsError } from '../hooks/lib/args.mjs';
import { findBookRoot, BibleError, DEFAULT_STATE_DIR, POINTER_FILE } from '../hooks/lib/bible.mjs';
import {
  SUPPORTED_MAJOR,
  checkSchemaVersion,
  runChecks
} from '../hooks/lib/doctor-engine.mjs';
import { buildAdoptPlan } from '../hooks/lib/adopt-plan.mjs';

// ---- arg parsing ---------------------------------------------------------------

let opts;
try {
  opts = parseArgs(process.argv.slice(2), [
    // --check is a BOOLEAN mode flag for ns-doctor (inline type override because the
    // shared FLAG_DEFS defines it as a list; see note in S-07 section 4).
    { name: 'check', type: 'boolean' },
    { name: 'migrate', type: 'boolean' },
    { name: 'adopt-plan', type: 'boolean' },
    { name: 'chapters-dir', type: 'string' },
    'report',
    'validate-packs',
    'project',
    'json',
  ]);
} catch (err) {
  if (err.name === 'ArgsError') {
    process.stderr.write('ns-doctor: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// ---- book root discovery -------------------------------------------------------

const startDir = opts.project ? resolve(opts.project) : process.cwd();

// ---- --adopt-plan mode (ADR-0016, adopting an existing book) ---------------------
// Reads the one directory it is given (the current directory, or --project), never walks up
// to an enclosing book, and writes nothing. It always prints JSON, which is what the nfs-adopt
// skill reads; --json is accepted and changes nothing. --chapters-dir=<name> lists the chapters
// of that candidate folder instead of the one with the most Markdown files. Exit 0 with a plan;
// 2 when the directory cannot be read or --chapters-dir names no candidate.

/**
 * Whether dir is inside a git working tree, and how many paths under it git reports as
 * changed. Null when git is not installed or dir is not in a working tree. The plan module
 * never spawns a process, so the probe lives here.
 */
function gitProbe(dir) {
  const inside = spawnSync('git', ['-C', dir, 'rev-parse', '--is-inside-work-tree'], { encoding: 'utf8' });
  if (inside.error || inside.status !== 0 || inside.stdout.trim() !== 'true') return null;
  const status = spawnSync('git', ['-C', dir, 'status', '--porcelain', '--', '.'], { encoding: 'utf8' });
  if (status.error || status.status !== 0) return null;
  return { work_tree: true, uncommitted: status.stdout.split('\n').filter((l) => l.trim() !== '').length };
}

if (opts['adopt-plan']) {
  let isDir = false;
  try {
    isDir = statSync(startDir).isDirectory();
  } catch {
    isDir = false;
  }
  if (!isDir) {
    process.stderr.write('ns-doctor: --adopt-plan: not a readable directory: ' + startDir + '\n');
    process.exit(2);
  }
  let plan;
  try {
    plan = buildAdoptPlan(startDir, { git: gitProbe(startDir), chaptersDir: opts['chapters-dir'] || null });
  } catch (err) {
    if (err.code !== 'NOT_A_CANDIDATE') throw err;
    process.stderr.write('ns-doctor: --adopt-plan: ' + err.message + '\n');
    process.exit(2);
  }
  process.stdout.write(JSON.stringify(plan, null, 2) + '\n');
  process.exit(0);
}

/**
 * Reports a book whose state folder cannot be resolved (ADR-0015, state folder name) in the
 * normal report shape, so the nfs-doctor skill can read the folder names off the findings
 * and offer the move. Exit 2: the checks cannot run until the folder is resolved.
 */
function emitStateFolderReport(status, findings) {
  if (opts.json) {
    process.stdout.write(JSON.stringify({
      check: 'doctor',
      status,
      findings,
      notices: [],
      migrationAvailable: false
    }, null, 2) + '\n');
  } else {
    process.stdout.write('[doctor] ' + status + ': ' + findings.length + ' finding(s):\n');
    for (const f of findings) {
      process.stdout.write('  ' + f.path + ' [' + f.type + ']: ' + f.message + '\n');
    }
  }
  process.exit(2);
}

let root, meta, config;
try {
  ({ root, meta, config } = findBookRoot(startDir));
} catch (err) {
  if (err.name === 'BibleError' && err.code === 'NO_BOOK_ROOT' &&
      Array.isArray(err.candidates) && err.candidates.length > 0) {
    emitStateFolderReport('state-folder-unpointed', err.candidates.map((name) => ({
      type: 'state.unpointed-folder',
      path: name + '/',
      message: 'folder "' + name + '" holds this book\'s records, but the plugin expects "' +
        DEFAULT_STATE_DIR + '"; run /nonfiction-studio:nfs-doctor migrate to rename it or to ' +
        'record its name in ' + POINTER_FILE
    })));
  }
  if (err.name === 'BibleError' && err.code === 'STATE_POINTER_INVALID') {
    emitStateFolderReport('state-pointer-invalid', [{
      type: 'state.pointer-invalid',
      path: POINTER_FILE,
      message: err.message
    }]);
  }
  if (err.name === 'BibleError') {
    process.stderr.write('ns-doctor: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// ---- --validate-packs mode -----------------------------------------------------
// Craft-pack validation: registered but not-yet (no packs exist until Phase 2).
// Reports "no packs directory" cleanly and exits 0.

if (opts['validate-packs']) {
  const packsDir = join(root, 'packs');
  if (!existsSync(packsDir)) {
    if (opts.json) {
      process.stdout.write(JSON.stringify({
        check: 'validate-packs',
        status: 'no-packs',
        message: 'no packs directory found; craft-model packs ship in Phase 2 per D-21'
      }, null, 2) + '\n');
    } else {
      process.stdout.write('[validate-packs] no packs directory; craft-model packs arrive in Phase 2\n');
    }
    process.exit(0);
  }
  // Packs directory exists but no validator is implemented yet.
  if (opts.json) {
    process.stdout.write(JSON.stringify({
      check: 'validate-packs',
      status: 'no-packs-validator',
      message: 'packs directory found but pack schema validation is not yet implemented (Phase 2)'
    }, null, 2) + '\n');
  } else {
    process.stdout.write('[validate-packs] packs directory found; pack validation arrives in Phase 2\n');
  }
  process.exit(0);
}

// ---- --migrate mode ------------------------------------------------------------
// v1 scope: schema_version match check only.
// Older majors (genuinely incompatible) exit 2 naming both versions. Current major
// with --migrate exits 0: there is nothing to migrate, which is success, not an
// error indistinguishable from a broken bible (F-HK-09). No destructive operations.

if (opts.migrate) {
  const versionCheck = checkSchemaVersion(meta);
  if (!versionCheck.ok) {
    const msg = versionCheck.message || 'migration required';
    process.stderr.write('ns-doctor: ' + msg + '\n');
    process.exit(2);
  }
  // Current version with --migrate: nothing to migrate. This is success (exit 0),
  // not the exit-2 error path - a current schema is not a broken bible.
  const noMigMsg =
    'nothing to migrate, schema is current (schema_version "' + SUPPORTED_MAJOR + '"); ' +
    'migrations arrive with the first schema change per Q-04 (release, versioning, and compatibility)';
  if (opts.json) {
    process.stdout.write(JSON.stringify({
      check: 'migrate',
      status: 'current',
      schemaVersion: SUPPORTED_MAJOR,
      message: noMigMsg
    }, null, 2) + '\n');
  } else {
    process.stdout.write('[migrate] ' + noMigMsg + '\n');
  }
  process.exit(0);
}

// ---- schema version check (prelude to all check/report modes) ------------------
// Older schema_version exits 2 with migration-required message before running checks.

const versionCheck = checkSchemaVersion(meta);
if (!versionCheck.ok) {
  const msg = versionCheck.message || 'migration required';
  if (opts.json) {
    process.stdout.write(JSON.stringify({
      check: 'doctor',
      status: 'migration-required',
      schemaVersion: versionCheck.current,
      supportedVersion: versionCheck.supported,
      message: msg,
      migrationAvailable: false
    }, null, 2) + '\n');
  } else {
    process.stdout.write('[doctor] migration-required: ' + msg + '\n');
  }
  process.exit(2);
}

// ---- run checks (--check, --report, or default) --------------------------------
// --check and --report both run the full check inventory in v1.
// Default (no mode flag) also runs the full check inventory.

const { findings, notices } = runChecks(root);

// ---- emit ----------------------------------------------------------------------

const hasFindings = findings.length > 0;
const status = hasFindings ? 'warnings' : 'valid';
const exitCode = hasFindings ? 1 : 0;

if (opts.json) {
  const json = {
    check: 'doctor',
    schemaVersion: SUPPORTED_MAJOR,
    status,
    findings: findings.map(f => ({ type: f.type, path: f.path, message: f.message })),
    notices: notices.map(n => ({ type: n.type, path: n.path, message: n.message })),
    migrationAvailable: false
  };
  process.stdout.write(JSON.stringify(json, null, 2) + '\n');
} else {
  const prefix = '[doctor]';

  // Emit notices first (informational, never cause exit 1)
  for (const n of notices) {
    process.stdout.write(prefix + ' NOTICE [' + n.type + ']: ' + n.message + '\n');
  }

  if (!hasFindings) {
    process.stdout.write(prefix + ' pass: bible is valid, no issues found\n');
  } else {
    process.stdout.write(prefix + ' ' + findings.length + ' finding(s):\n');
    for (const f of findings) {
      const loc = f.path || '(no path)';
      process.stdout.write('  ' + loc + ' [' + f.type + ']: ' + f.message + '\n');
    }
  }
}

process.exit(exitCode);
