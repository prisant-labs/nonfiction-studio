#!/usr/bin/env node
// what-it-is:   the ns-stylometry voice-drift CLI (thin shell over hooks/lib/stylometry-engine.mjs)
// what-it-does: parses arguments, locates the book root, reads the baseline from config.json,
//               reads chapter files, measures the eight-marker vector, computes drift, and emits
//               a gate report; exits 0 when score is below threshold, 1 when exceeded, 2 on error
// why:          the CLI is the public surface; all logic lives in stylometry-engine.mjs so hooks
//               and CI share the same computation path per S-07 section 4
// usage:        ns-stylometry [--chapter=<slug>|--all] [--baseline=<path>] [--measure=<path>[,<path>...]]
//               [--calibrate=<path>[,<path>...]] [--project=<dir>] [--json] [--explain]

import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { join, relative, resolve } from 'node:path';
import { parseArgs, ArgsError } from '../hooks/lib/args.mjs';
import { findBookRoot, BibleError } from '../hooks/lib/bible.mjs';
import {
  measureChapter, measureBook, computeDrift, countWords, CURRENT_MARKER_SET_VERSION,
} from '../hooks/lib/stylometry-engine.mjs';
import { calibrateBaseline } from '../hooks/lib/stylometry-calibration.mjs';

// ---- arg parsing ---------------------------------------------------------------

let opts;
try {
  opts = parseArgs(process.argv.slice(2), [
    'chapter', 'all', 'baseline', 'project', 'json',
    { name: 'measure', type: 'list' },
    { name: 'calibrate', type: 'list' },
    { name: 'explain', type: 'boolean' },
  ]);
} catch (err) {
  if (err.name === 'ArgsError') {
    process.stderr.write('ns-stylometry: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// ---- measure mode (read files, compute vector, print JSON; reads no config, writes nothing) -----
// usage: ns-stylometry --measure=<path>[,<path>...]
// single file: measureChapter; multiple files: measureBook (aggregated counts before ratios).
// JSON implied; exit 0 on success, exit 2 on missing or unreadable file.
// Output carries marker_set_version alongside markers so the capture path (voice-capture
// agent) writes both into stylometry.baseline by construction, rather than depending on
// prose in several separate files staying in sync with a constant in this engine. Without
// this, a freshly captured baseline would carry no marker_set_version at all, which
// computeDrift's stale-baseline guard treats as version 1 and rejects -- the exact defect
// this field closes.

if (opts.measure !== null) {
  if (opts.measure.length === 0) {
    process.stderr.write('ns-stylometry: --measure requires at least one file path\n');
    process.exit(2);
  }

  const texts = [];
  const resolvedPaths = [];
  let totalWords = 0;

  for (const rawPath of opts.measure) {
    const absPath = resolve(rawPath);
    let text;
    try {
      text = readFileSync(absPath, 'utf8');
    } catch (err) {
      process.stderr.write('ns-stylometry: cannot read file: ' + absPath + '\n');
      process.exit(2);
    }
    texts.push(text);
    resolvedPaths.push(absPath.replace(/\\/g, '/'));
    totalWords += countWords(text);
  }

  const markers = texts.length === 1 ? measureChapter(texts[0]) : measureBook(texts);
  const out = {
    markers, marker_set_version: CURRENT_MARKER_SET_VERSION, files: resolvedPaths, totalWords,
  };
  process.stdout.write(JSON.stringify(out, null, 2) + '\n');
  process.exit(0);
}

// ---- calibrate mode (read files, run the five-rung calibration recipe, print JSON; reads no
// config, writes nothing) --------------------------------------------------------
// usage: ns-stylometry --calibrate=<path>[,<path>...]
// Deterministic: byte-identical stdout for identical input files (calibrateBaseline's own seed
// default, 4242, is unconditional here -- there is no --seed flag). Exit 0 on success; exit 1
// when the given files are too small to calibrate (CorpusTooSmallError -- a data-insufficiency
// outcome, distinct from the exit-2 usage/I-O errors elsewhere in this file); exit 2 on missing
// or unreadable file. A plain-language regime disclosure is written to stderr, separate from the
// stdout JSON, so a human running this directly sees the verdict-scope decision without parsing
// JSON (the honest-disclosure default per this implementation wave's design pins).

if (opts.calibrate !== null) {
  if (opts.calibrate.length === 0) {
    process.stderr.write('ns-stylometry: --calibrate requires at least one file path\n');
    process.exit(2);
  }

  const calibTexts = [];
  const calibResolvedPaths = [];
  let calibTotalWords = 0;

  for (const rawPath of opts.calibrate) {
    const absPath = resolve(rawPath);
    let text;
    try {
      text = readFileSync(absPath, 'utf8');
    } catch (err) {
      process.stderr.write('ns-stylometry: cannot read file: ' + absPath + '\n');
      process.exit(2);
    }
    calibTexts.push(text);
    calibResolvedPaths.push(absPath.replace(/\\/g, '/'));
    calibTotalWords += countWords(text);
  }

  let calibResult;
  try {
    calibResult = calibrateBaseline(calibTexts);
  } catch (err) {
    if (err.name === 'CorpusTooSmallError') {
      process.stderr.write('ns-stylometry: ' + err.message + '\n');
      process.exit(err.exitCode);
    }
    throw err;
  }

  const calibOut = {
    markers: calibResult.markers,
    marker_set_version: CURRENT_MARKER_SET_VERSION,
    calibration: calibResult.calibration,
    files: calibResolvedPaths,
    totalWords: calibTotalWords,
  };
  process.stdout.write(JSON.stringify(calibOut, null, 2) + '\n');

  // Two sentences, per this implementation wave's honest-disclosure default: one names the
  // regime, the other names why -- not a single combined sentence, so each half of the
  // disclosure is independently quotable.
  const aucStr = calibResult.calibration.detectability_auc.toFixed(3);
  const regimeSpan = calibResult.calibration.spans[0];
  if (calibResult.calibration.regime === 'chapter') {
    process.stderr.write(
      'ns-stylometry: regime = chapter. Detectability AUC ' + aucStr + ' at the ' + regimeSpan +
      '-word rung meets the 0.95 bar, so per-chapter verdicts are supportable.\n'
    );
  } else {
    process.stderr.write(
      'ns-stylometry: regime = book. Detectability AUC ' + aucStr + ' at the ' + regimeSpan +
      '-word rung falls short of the 0.95 bar, so only a book-scale aggregate verdict is supportable.\n'
    );
  }
  process.exit(0);
}

// ---- book root discovery -------------------------------------------------------

const startDir = opts.project ? resolve(opts.project) : process.cwd();

let root;
try {
  ({ root } = findBookRoot(startDir));
} catch (err) {
  if (err.name === 'BibleError') {
    process.stderr.write('ns-stylometry: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// ---- baseline discovery --------------------------------------------------------

let baseline;
let thresholds;

if (opts.baseline) {
  // Explicit --baseline path: read a JSON file containing the markers object directly
  // or a config-shaped object with stylometry.baseline.markers.
  const bPath = resolve(opts.baseline);
  if (!existsSync(bPath)) {
    process.stderr.write('ns-stylometry: baseline file not found: ' + bPath + '\n');
    process.exit(2);
  }
  let bData;
  try {
    bData = JSON.parse(readFileSync(bPath, 'utf8'));
  } catch (err) {
    process.stderr.write('ns-stylometry: cannot read baseline file ' + bPath + ': ' + err.message + '\n');
    process.exit(2);
  }
  // Accept a config-shaped object (stylometry.baseline.markers), a bare baseline
  // object (markers plus marker_set_version), or a raw flat markers object. A raw
  // flat markers object has no marker_set_version, so computeDrift treats it as
  // version 1 and rejects it via the stale-baseline guard -- the same rule applied
  // everywhere else, because a hand-saved flat vector predates this engine's
  // correction to type_token_ratio just as surely as an old config.json baseline.
  if (bData && bData.stylometry && bData.stylometry.baseline && bData.stylometry.baseline.markers) {
    baseline = bData.stylometry.baseline;
  } else if (bData && bData.markers) {
    baseline = bData;
  } else {
    baseline = { markers: bData };
  }
  thresholds = (bData && bData.thresholds) ? bData.thresholds : null;
} else {
  // Default: read from .studio/config.json
  const configPath = join(root, '.studio', 'config.json');
  if (!existsSync(configPath)) {
    process.stderr.write(
      'ns-stylometry: config.json not found at ' + configPath +
      ' -- run voice-capture to create a baseline\n'
    );
    process.exit(2);
  }
  let config;
  try {
    config = JSON.parse(readFileSync(configPath, 'utf8'));
  } catch (err) {
    process.stderr.write('ns-stylometry: cannot read config.json at ' + configPath + ': ' + err.message + '\n');
    process.exit(2);
  }
  if (!config || !config.stylometry || !config.stylometry.baseline ||
      !config.stylometry.baseline.markers) {
    process.stderr.write(
      'ns-stylometry: no baseline vector found in ' + configPath +
      ' (stylometry.baseline.markers is missing or null) -- run voice-capture to capture a baseline\n'
    );
    process.exit(2);
  }
  baseline = config.stylometry.baseline;
  thresholds = config.thresholds || null;
}

// ---- chapter discovery ---------------------------------------------------------

const chapterDir = join(root, 'chapters');
if (!existsSync(chapterDir)) {
  process.stderr.write('ns-stylometry: chapters/ directory not found at ' + chapterDir + '\n');
  process.exit(2);
}

let chapterPaths;
if (opts.chapter) {
  const p = join(chapterDir, opts.chapter + '.md');
  if (!existsSync(p)) {
    process.stderr.write('ns-stylometry: chapter not found: ' + p + '\n');
    process.exit(2);
  }
  chapterPaths = [p];
} else {
  // --all or no scope: every .md file in chapters/, sorted by name
  chapterPaths = readdirSync(chapterDir)
    .filter(f => f.endsWith('.md'))
    .sort()
    .map(f => join(chapterDir, f));
}

// ---- read chapter texts --------------------------------------------------------

const chapterTexts = [];
const chapterFiles = [];
for (const absPath of chapterPaths) {
  let text;
  try {
    text = readFileSync(absPath, 'utf8');
  } catch (err) {
    process.stderr.write('ns-stylometry: cannot read chapter ' + absPath + ': ' + err.message + '\n');
    process.exit(2);
  }
  chapterTexts.push(text);
  chapterFiles.push(relative(root, absPath).replace(/\\/g, '/'));
}

// Zero-chapter edge case: no chapters means no drift. There is no measured vector and no
// statistic here, so --explain has nothing to rank; per the judgment call recorded in
// docs/reference/cli/ns-stylometry.md, it states that reason rather than staying silent,
// matching how this branch already speaks (not silently) when --explain is absent.
if (chapterTexts.length === 0) {
  const NO_CHAPTERS_EXPLAIN_NOTE = 'no chapters to scan; nothing to explain';
  const outJson = {
    check: 'stylometry',
    verdict: 'pass',
    detail: 'no chapters to scan',
    statistic: null,
    worstMarker: null,
    threshold: null,
    exceeded: false,
    regime: null,
    status: 'pass',
    markers: {},
    scoredWords: 0,
    explain: opts.explain
      ? {
        threshold: null, markerTolerance: null,
        perMarker: [], note: NO_CHAPTERS_EXPLAIN_NOTE,
      }
      : undefined,
    chapters: [],
    findings: [],
    ts: new Date().toISOString(),
  };
  if (opts.json) {
    process.stdout.write(JSON.stringify(outJson, null, 2) + '\n');
  } else {
    process.stdout.write('[stylometry] pass: no chapters to scan\n');
    if (opts.explain) {
      process.stdout.write('  ' + NO_CHAPTERS_EXPLAIN_NOTE + '\n');
    }
  }
  process.exit(0);
}

// ---- measure and compute drift -------------------------------------------------

// scoredWords: the same countWords authority measure mode already uses, summed over every
// chapter text being scored (single chapter or the whole book) -- the word count the
// calibration ladder is looked up at (P1).
const scoredWords = chapterTexts.reduce((sum, text) => sum + countWords(text), 0);

const measured = measureBook(chapterTexts);
let statistic, worstMarker, threshold, exceeded, regime, perMarker, markerTolerance, deprecations;
try {
  ({ statistic, worstMarker, threshold, exceeded, regime, perMarker, markerTolerance, deprecations } =
    computeDrift(measured, baseline, thresholds, { scoredWords }));
} catch (err) {
  // Covers a malformed baseline (missing .markers), a stale marker_set_version
  // (StaleBaselineError names nfs-capture-voice as the remedy), and an incomplete v5
  // calibration ladder (InvalidCalibrationError, same remedy).
  process.stderr.write('ns-stylometry: ' + err.message + '\n');
  process.exit(2);
}

// P7 (ADR-0012 voice verdict scope): thresholds.drift_score_max is retired and read by nothing
// here for scoring; computeDrift's own deprecations array carries the one canonical retirement
// string when the key is present in config, surfaced here on stderr (the gate's own equivalent
// surface is its check `detail`, once per run -- both surfaces are tested).
for (const notice of deprecations) {
  process.stderr.write('ns-stylometry: ' + notice + '\n');
}

const flaggedMarkers = perMarker.filter(m => m.flagged);

// Exit code is determined solely by the calibrated statistic vs its threshold; gate mode is not
// read. exit 0: not exceeded (passes), exit 1: exceeded. --explain never reads or changes this:
// it composes with the existing modes rather than replacing them.
const exitCode = exceeded ? 1 : 0;

// perMarker ordered by |z| descending, so the marker that drove the verdict is always named
// first -- a stable sort, so markers tied on |z| keep the baseline's own declared order rather
// than an arbitrary one. Only built when --explain is requested.
const sortedForExplain = opts.explain
  ? [...perMarker].sort((a, b) => Math.abs(b.z) - Math.abs(a.z))
  : null;

// Build per-marker delta map for the JSON shape. deviationPct stays the honest, signed-magnitude
// value; z is the SIGNED standardized deviation the verdict statistic is drawn from (P1) --
// this replaces the retired capped/contribution pair (v4) entirely, not alongside it.
const markersObj = {};
for (const m of perMarker) {
  markersObj[m.marker] = {
    baseline: m.baseline,
    measured: m.measured,
    deviationPct: m.deviationPct,
    z: m.z,
    flagged: m.flagged,
  };
}

// Build findings array: one entry per flagged marker.
const findings = flaggedMarkers.map(m => ({
  file: null,
  line: null,
  type: 'stylometry.marker_flag',
  excerpt: m.marker,
  detail: m.marker + ': baseline=' + m.baseline.toFixed(4) +
          ' measured=' + m.measured.toFixed(4) +
          ' deviation=' + m.deviationPct.toFixed(2) + '%',
}));

const verdict = exceeded ? 'block' : 'pass';
const outJson = {
  check: 'stylometry',
  verdict,
  // Boundary wording matches hooks/lib/gate-engine.mjs's own stylometry detail phrasing
  // ("drift statistic N.NN {within|exceeds} threshold N.NN"), naming the worst marker and the
  // calibrated threshold consistently across both surfaces (this task's brief).
  detail: exceeded
    ? 'drift statistic ' + statistic.toFixed(2) + ' (worst marker ' + worstMarker +
      ') exceeds calibrated threshold ' + threshold.toFixed(2)
    : 'drift statistic ' + statistic.toFixed(2) + ' (worst marker ' + worstMarker +
      ') within calibrated threshold ' + threshold.toFixed(2),
  statistic,
  worstMarker,
  threshold,
  exceeded,
  regime,
  status: exceeded ? 'block' : 'pass',
  markers: markersObj,
  scoredWords,
  // --explain surfaces data computeDrift already computed (z, markerTolerance) but the
  // pre-existing markers/findings shape above never carried: ordered by |z| descending, so the
  // marker that drove the verdict is first. markerTolerance is included so the block is
  // self-contained -- flagged is already a boolean on every entry, this is the number it was
  // compared against, not a new signal. Present only when the flag is passed -- JSON.stringify
  // drops an undefined-valued key, so a consumer who never asks for --explain sees byte-for-byte
  // the same shape this CLI produces without it.
  explain: opts.explain
    ? {
      threshold,
      markerTolerance,
      perMarker: sortedForExplain.map(m => ({
        marker: m.marker,
        baseline: m.baseline,
        measured: m.measured,
        deviationPct: m.deviationPct,
        z: m.z,
        flagged: m.flagged,
      })),
    }
    : undefined,
  chapters: chapterFiles,
  findings,
  ts: new Date().toISOString(),
};

// ---- explain rendering (text mode) ----------------------------------------------

/**
 * Renders the full per-marker breakdown for --explain's text output: every marker's baseline,
 * measured value, honest (signed-magnitude) deviation, SIGNED standardized deviation (z), and
 * whether it crossed the per-marker tolerance band, ordered by |z| descending (sortedMarkers is
 * pre-sorted by the caller) so the marker driving the verdict statistic reads first. This is
 * presentation only -- every number it prints already came out of computeDrift; nothing here
 * re-derives or re-measures anything.
 *
 * The leading "* " / "  " marker restores a signal the pre-existing flagged-markers-only text
 * loop carried by construction (every line it printed was, by definition, a marker that had
 * crossed the tolerance band) and that this rendering would otherwise have silently dropped,
 * since it lists every marker rather than only the flagged ones. The tolerance value itself is
 * stated once, in the header line, rather than repeated on every row, because it is the same
 * number for every marker in a single run.
 *
 * Formatting matches hooks/lib/statusline-engine.mjs's own convention for deterministic output:
 * toFixed plus string concatenation, never toLocaleString or any other locale-sensitive
 * formatting, so this line is byte-identical on the Ubuntu and Windows CI legs.
 *
 * @param {object[]} sortedMarkers - perMarker records, already sorted by |z| descending
 * @param {number} threshold - the calibrated threshold the verdict statistic is compared against
 * @param {number} markerTolerance - the per-marker tolerance band flagged is computed against
 * @returns {string} multi-line text, newline-terminated
 */
function renderExplainText(sortedMarkers, threshold, markerTolerance) {
  if (sortedMarkers.length === 0) return '  nothing to explain: no markers were measured\n';

  const top = sortedMarkers[0];
  let out = 'Worst marker: ' + top.marker + ', z=' + top.z.toFixed(4) +
    ' (calibrated threshold ' + threshold.toFixed(2) + ')\n';
  out += '\nMarkers ranked by |z| (largest first); * marks a marker whose honest deviation ' +
    'crosses the ' + markerTolerance.toFixed(2) + '% per-marker tolerance band:\n';

  const nameWidth = Math.max(...sortedMarkers.map(m => m.marker.length));
  for (const m of sortedMarkers) {
    const flagPrefix = m.flagged ? '* ' : '  ';
    out +=
      flagPrefix + m.marker.padEnd(nameWidth + 1) +
      ' z ' + m.z.toFixed(4).padStart(9) +
      '  deviation ' + (m.deviationPct.toFixed(2) + '%').padStart(8) +
      '  baseline ' + m.baseline.toFixed(4) +
      '  measured ' + m.measured.toFixed(4) + '\n';
  }
  return out;
}

// ---- emit ----------------------------------------------------------------------

if (opts.json) {
  process.stdout.write(JSON.stringify(outJson, null, 2) + '\n');
} else {
  const prefix = '[stylometry]';
  const statisticStr = statistic.toFixed(2);
  if (!exceeded) {
    process.stdout.write(
      prefix + ' pass: drift statistic ' + statisticStr + ' < calibrated threshold ' + threshold.toFixed(2) + '\n'
    );
    if (opts.explain) {
      process.stdout.write(renderExplainText(sortedForExplain, threshold, markerTolerance));
    }
  } else {
    process.stdout.write(
      prefix + ' drift statistic ' + statisticStr + ' exceeds calibrated threshold ' + threshold.toFixed(2) + '\n'
    );
    if (opts.explain) {
      process.stdout.write(renderExplainText(sortedForExplain, threshold, markerTolerance));
    } else {
      for (const m of flaggedMarkers) {
        process.stdout.write(
          '  [' + m.marker + '] z=' + m.z.toFixed(4) + ' deviation ' + m.deviationPct.toFixed(2) +
          '% (baseline=' + m.baseline.toFixed(4) + ' measured=' + m.measured.toFixed(4) + ')\n'
        );
      }
    }
  }
}

process.exit(exitCode);
