#!/usr/bin/env node
// what-it-is:   the ns-stylometry voice-drift CLI (thin shell over hooks/lib/stylometry-engine.mjs)
// what-it-does: parses arguments, locates the book root, reads the baseline from config.json,
//               reads chapter files, measures the eight-marker vector, computes drift, and emits
//               a gate report; exits 0 when score is below threshold, 1 when exceeded, 2 on error
// why:          the CLI is the public surface; all logic lives in stylometry-engine.mjs so hooks
//               and CI share the same computation path per S-07 section 4
// usage:        ns-stylometry [--chapter=<slug>|--all] [--baseline=<path>] [--measure=<path>[,<path>...]]
//               [--project=<dir>] [--json] [--explain]

import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { join, relative, resolve } from 'node:path';
import { parseArgs, ArgsError } from '../hooks/lib/args.mjs';
import { findBookRoot, BibleError } from '../hooks/lib/bible.mjs';
import {
  measureChapter, measureBook, computeDrift, countWords, CURRENT_MARKER_SET_VERSION,
  DEFAULT_DRIFT_SCORE_MAX,
} from '../hooks/lib/stylometry-engine.mjs';

// ---- arg parsing ---------------------------------------------------------------

let opts;
try {
  opts = parseArgs(process.argv.slice(2), [
    'chapter', 'all', 'baseline', 'project', 'json',
    { name: 'measure', type: 'list' },
    { name: 'explain', type: 'boolean' },
  ]);
} catch (err) {
  if (err.name === 'ArgsError') {
    process.stderr.write('ns-stylometry: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// ---- measure mode (read files, compute vector, print JSON; reads no config, writes nothing) -----
// usage: ns-stylometry --measure=<path>[,<path>...]
// single file: measureChapter; multiple files: measureBook (aggregated counts before ratios).
// JSON implied; exit 0 on success, exit 2 on missing or unreadable file.
// Output carries marker_set_version alongside markers so the capture path (voice-capture
// agent) writes both into stylometry.baseline by construction, rather than depending on
// prose in several separate files staying in sync with a constant in this engine. Without
// this, a freshly captured baseline would carry no marker_set_version at all, which
// computeDrift's stale-baseline guard treats as version 1 and rejects -- the exact defect
// this field closes.

if (opts.measure !== null) {
  if (opts.measure.length === 0) {
    process.stderr.write('ns-stylometry: --measure requires at least one file path\n');
    process.exit(2);
  }

  const texts = [];
  const resolvedPaths = [];
  let totalWords = 0;

  for (const rawPath of opts.measure) {
    const absPath = resolve(rawPath);
    let text;
    try {
      text = readFileSync(absPath, 'utf8');
    } catch (err) {
      process.stderr.write('ns-stylometry: cannot read file: ' + absPath + '\n');
      process.exit(2);
    }
    texts.push(text);
    resolvedPaths.push(absPath.replace(/\\/g, '/'));
    totalWords += countWords(text);
  }

  const markers = texts.length === 1 ? measureChapter(texts[0]) : measureBook(texts);
  const out = {
    markers, marker_set_version: CURRENT_MARKER_SET_VERSION, files: resolvedPaths, totalWords,
  };
  process.stdout.write(JSON.stringify(out, null, 2) + '\n');
  process.exit(0);
}

// ---- book root discovery -------------------------------------------------------

const startDir = opts.project ? resolve(opts.project) : process.cwd();

let root;
try {
  ({ root } = findBookRoot(startDir));
} catch (err) {
  if (err.name === 'BibleError') {
    process.stderr.write('ns-stylometry: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// ---- baseline discovery --------------------------------------------------------

let baseline;
let thresholds;

if (opts.baseline) {
  // Explicit --baseline path: read a JSON file containing the markers object directly
  // or a config-shaped object with stylometry.baseline.markers.
  const bPath = resolve(opts.baseline);
  if (!existsSync(bPath)) {
    process.stderr.write('ns-stylometry: baseline file not found: ' + bPath + '\n');
    process.exit(2);
  }
  let bData;
  try {
    bData = JSON.parse(readFileSync(bPath, 'utf8'));
  } catch (err) {
    process.stderr.write('ns-stylometry: cannot read baseline file ' + bPath + ': ' + err.message + '\n');
    process.exit(2);
  }
  // Accept a config-shaped object (stylometry.baseline.markers), a bare baseline
  // object (markers plus marker_set_version), or a raw flat markers object. A raw
  // flat markers object has no marker_set_version, so computeDrift treats it as
  // version 1 and rejects it via the stale-baseline guard -- the same rule applied
  // everywhere else, because a hand-saved flat vector predates this engine's
  // correction to type_token_ratio just as surely as an old config.json baseline.
  if (bData && bData.stylometry && bData.stylometry.baseline && bData.stylometry.baseline.markers) {
    baseline = bData.stylometry.baseline;
  } else if (bData && bData.markers) {
    baseline = bData;
  } else {
    baseline = { markers: bData };
  }
  thresholds = (bData && bData.thresholds) ? bData.thresholds : null;
} else {
  // Default: read from .studio/config.json
  const configPath = join(root, '.studio', 'config.json');
  if (!existsSync(configPath)) {
    process.stderr.write(
      'ns-stylometry: config.json not found at ' + configPath +
      ' -- run voice-capture to create a baseline\n'
    );
    process.exit(2);
  }
  let config;
  try {
    config = JSON.parse(readFileSync(configPath, 'utf8'));
  } catch (err) {
    process.stderr.write('ns-stylometry: cannot read config.json at ' + configPath + ': ' + err.message + '\n');
    process.exit(2);
  }
  if (!config || !config.stylometry || !config.stylometry.baseline ||
      !config.stylometry.baseline.markers) {
    process.stderr.write(
      'ns-stylometry: no baseline vector found in ' + configPath +
      ' (stylometry.baseline.markers is missing or null) -- run voice-capture to capture a baseline\n'
    );
    process.exit(2);
  }
  baseline = config.stylometry.baseline;
  thresholds = config.thresholds || null;
}

// ---- chapter discovery ---------------------------------------------------------

const chapterDir = join(root, 'chapters');
if (!existsSync(chapterDir)) {
  process.stderr.write('ns-stylometry: chapters/ directory not found at ' + chapterDir + '\n');
  process.exit(2);
}

let chapterPaths;
if (opts.chapter) {
  const p = join(chapterDir, opts.chapter + '.md');
  if (!existsSync(p)) {
    process.stderr.write('ns-stylometry: chapter not found: ' + p + '\n');
    process.exit(2);
  }
  chapterPaths = [p];
} else {
  // --all or no scope: every .md file in chapters/, sorted by name
  chapterPaths = readdirSync(chapterDir)
    .filter(f => f.endsWith('.md'))
    .sort()
    .map(f => join(chapterDir, f));
}

// ---- read chapter texts --------------------------------------------------------

const chapterTexts = [];
const chapterFiles = [];
for (const absPath of chapterPaths) {
  let text;
  try {
    text = readFileSync(absPath, 'utf8');
  } catch (err) {
    process.stderr.write('ns-stylometry: cannot read chapter ' + absPath + ': ' + err.message + '\n');
    process.exit(2);
  }
  chapterTexts.push(text);
  chapterFiles.push(relative(root, absPath).replace(/\\/g, '/'));
}

// Zero-chapter edge case: no chapters means no drift. There is no measured vector and no
// score here, so --explain has nothing to rank; per the judgment call recorded in
// docs/reference/cli/ns-stylometry.md, it states that reason rather than staying silent,
// matching how this branch already speaks (not silently) when --explain is absent.
if (chapterTexts.length === 0) {
  const driftScoreMax = (thresholds && thresholds.drift_score_max != null) ? thresholds.drift_score_max : DEFAULT_DRIFT_SCORE_MAX;
  const NO_CHAPTERS_EXPLAIN_NOTE = 'no chapters to scan; nothing to explain';
  const outJson = {
    check: 'stylometry',
    verdict: 'pass',
    detail: 'no chapters to scan',
    driftScore: 0,
    threshold: driftScoreMax,
    status: 'pass',
    markers: {},
    explain: opts.explain
      ? { budget: driftScoreMax, maxMarkerContribution: null, perMarker: [], note: NO_CHAPTERS_EXPLAIN_NOTE }
      : undefined,
    chapters: [],
    findings: [],
    ts: new Date().toISOString(),
  };
  if (opts.json) {
    process.stdout.write(JSON.stringify(outJson, null, 2) + '\n');
  } else {
    process.stdout.write('[stylometry] pass: no chapters to scan\n');
    if (opts.explain) {
      process.stdout.write('  ' + NO_CHAPTERS_EXPLAIN_NOTE + '\n');
    }
  }
  process.exit(0);
}

// ---- measure and compute drift -------------------------------------------------

const measured = measureBook(chapterTexts);
let score, perMarker, exceeded, maxMarkerContribution;
try {
  ({ score, perMarker, exceeded, maxMarkerContribution } = computeDrift(measured, baseline, thresholds));
} catch (err) {
  // Covers both a malformed baseline (missing .markers) and a stale
  // marker_set_version (StaleBaselineError names capture-voice as the remedy).
  process.stderr.write('ns-stylometry: ' + err.message + '\n');
  process.exit(2);
}

const driftScoreMax = (thresholds && thresholds.drift_score_max != null) ? thresholds.drift_score_max : DEFAULT_DRIFT_SCORE_MAX;
const flaggedMarkers = perMarker.filter(m => m.flagged);

// Exit code is determined solely by score vs threshold; gate mode is not read.
// exit 0: score < threshold (passes), exit 1: score >= threshold (exceeded). --explain never
// reads or changes this: it composes with the existing modes rather than replacing them.
const exitCode = exceeded ? 1 : 0;

// perMarker ordered by actual contribution to the score, largest first, so the marker that
// drove the verdict is always named first -- a stable sort, so markers tied on contribution
// keep the baseline's own declared order rather than an arbitrary one. Only built when
// --explain is requested.
const sortedForExplain = opts.explain
  ? [...perMarker].sort((a, b) => b.contribution - a.contribution)
  : null;

// Build per-marker delta map for the JSON shape (S-07 section 4 stdout schema).
// deviationPct is always the honest, uncapped value; capped records whether the
// per-marker contribution bound (roadmap row 1.7, voice registers) was binding
// for that marker, i.e. whether its actual contribution to driftScore was less
// than its deviationPct.
const markersObj = {};
for (const m of perMarker) {
  markersObj[m.marker] = {
    baseline: m.baseline,
    measured: m.measured,
    deviationPct: m.deviationPct,
    capped: m.capped,
    flagged: m.flagged,
  };
}

// Build findings array: one entry per flagged marker.
const findings = flaggedMarkers.map(m => ({
  file: null,
  line: null,
  type: 'stylometry.marker_flag',
  excerpt: m.marker,
  detail: m.marker + ': baseline=' + m.baseline.toFixed(4) +
          ' measured=' + m.measured.toFixed(4) +
          ' deviation=' + m.deviationPct.toFixed(2) + '%',
}));

const verdict = exceeded ? 'block' : 'pass';
const outJson = {
  check: 'stylometry',
  verdict,
  detail: exceeded
    ? 'drift score ' + score.toFixed(2) + ' exceeds threshold ' + driftScoreMax
    : 'drift score ' + score.toFixed(2) + ' is within threshold ' + driftScoreMax,
  driftScore: score,
  threshold: driftScoreMax,
  status: exceeded ? 'block' : 'pass',
  markers: markersObj,
  // --explain surfaces data computeDrift already computed (contribution, maxMarkerContribution)
  // but the pre-existing markers/findings shape above never carried: ordered by contribution
  // descending, so the marker that drove the verdict is first. Present only when the flag is
  // passed -- JSON.stringify drops an undefined-valued key, so a consumer who never asks for
  // --explain sees byte-for-byte the same shape this CLI produced before this flag existed.
  explain: opts.explain
    ? {
      budget: driftScoreMax,
      maxMarkerContribution,
      perMarker: sortedForExplain.map(m => ({
        marker: m.marker,
        baseline: m.baseline,
        measured: m.measured,
        deviationPct: m.deviationPct,
        contribution: m.contribution,
        capped: m.capped,
        flagged: m.flagged,
      })),
    }
    : undefined,
  chapters: chapterFiles,
  findings,
  ts: new Date().toISOString(),
};

// ---- explain rendering (text mode) ----------------------------------------------

/**
 * Renders the full per-marker breakdown for --explain's text output: every marker's baseline,
 * measured value, honest deviation, actual contribution, and whether the per-marker bound was
 * binding, ordered by contribution descending (sortedMarkers is pre-sorted by the caller) so the
 * driver of the score reads first. This is presentation only -- every number it prints already
 * came out of computeDrift; nothing here re-derives or re-measures anything.
 *
 * Formatting matches hooks/lib/statusline-engine.mjs's own convention for deterministic output:
 * toFixed plus string concatenation, never toLocaleString or any other locale-sensitive
 * formatting, so this line is byte-identical on the Ubuntu and Windows CI legs.
 *
 * @param {object[]} sortedMarkers - perMarker records, already sorted by contribution descending
 * @param {number} maxMarkerContribution - the per-marker bound in absolute terms
 * @returns {string} multi-line text, newline-terminated
 */
function renderExplainText(sortedMarkers, maxMarkerContribution) {
  if (sortedMarkers.length === 0) return '  nothing to explain: no markers were measured\n';

  const top = sortedMarkers[0];
  const topBoundNote = top.capped
    ? ' (bound was binding; honest deviation is ' + top.deviationPct.toFixed(2) + '%)'
    : '';
  let out = 'Top driver: ' + top.marker + ', contributing ' + top.contribution.toFixed(2) + topBoundNote + '\n';
  out += '\nMarkers ranked by contribution to the score (largest first):\n';

  const nameWidth = Math.max(...sortedMarkers.map(m => m.marker.length));
  for (const m of sortedMarkers) {
    const boundNote = m.capped
      ? 'bound was binding (max ' + maxMarkerContribution.toFixed(2) + ')'
      : 'bound not binding';
    out +=
      '  ' + m.marker.padEnd(nameWidth + 1) +
      ' contribution ' + m.contribution.toFixed(2).padStart(6) +
      '  deviation ' + (m.deviationPct.toFixed(2) + '%').padStart(8) +
      '  baseline ' + m.baseline.toFixed(4) +
      '  measured ' + m.measured.toFixed(4) +
      '  ' + boundNote + '\n';
  }
  return out;
}

// ---- emit ----------------------------------------------------------------------

if (opts.json) {
  process.stdout.write(JSON.stringify(outJson, null, 2) + '\n');
} else {
  const prefix = '[stylometry]';
  const scoreStr = score.toFixed(2);
  if (!exceeded) {
    process.stdout.write(
      prefix + ' pass: drift score ' + scoreStr + ' < threshold ' + driftScoreMax + '\n'
    );
    if (opts.explain) {
      process.stdout.write(renderExplainText(sortedForExplain, maxMarkerContribution));
    }
  } else {
    process.stdout.write(
      prefix + ' drift score ' + scoreStr + ' exceeds threshold ' + driftScoreMax + '\n'
    );
    if (opts.explain) {
      process.stdout.write(renderExplainText(sortedForExplain, maxMarkerContribution));
    } else {
      for (const m of flaggedMarkers) {
        process.stdout.write(
          '  [' + m.marker + '] deviation ' + m.deviationPct.toFixed(2) +
          '% (baseline=' + m.baseline.toFixed(4) + ' measured=' + m.measured.toFixed(4) + ')\n'
        );
      }
    }
  }
}

process.exit(exitCode);
