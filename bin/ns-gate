#!/usr/bin/env node
// what-it-is:   the ns-gate orchestrator CLI (thin shell over hooks/lib/gate-engine.mjs)
// what-it-does: parses arguments, locates the book root, delegates to gate-engine.mjs,
//               writes the gate report under _nonfiction-studio/gate/, emits to stdout, and exits
//               with the policy exit code; mode-DEPENDENT exit taxonomy (0/1/2) per TSK-029
// why:          the CLI is the public surface; all logic lives in gate-engine.mjs so
//               hooks/stop-gate.mjs and CI can share the same computation path per S-07 section 4
// usage:        ns-gate [--check=<checks>] [--chapter=<slug>] [--project=<dir>] [--json]

import { existsSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { parseArgs, ArgsError } from '../hooks/lib/args.mjs';
import { findBookRoot, BibleError, chaptersDirOf } from '../hooks/lib/bible.mjs';
import { runGate, writeGateReport, ALL_FLAGS, CHECK_REGISTRY } from '../hooks/lib/gate-engine.mjs';

// ---- arg parsing ---------------------------------------------------------------

let opts;
try {
  opts = parseArgs(process.argv.slice(2), ['check', 'chapter', 'project', 'json']);
} catch (err) {
  if (err.name === 'ArgsError') {
    process.stderr.write('ns-gate: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// Reject --check= with no items. An empty list is truthy in JavaScript, so
// without this guard it silently ran zero checks while still reporting a
// pass verdict (F-HK-08: empty check list silently passes).
if (opts.check && opts.check.length === 0) {
  process.stderr.write(
    'ns-gate: --check requires at least one check; valid checks: ' + ALL_FLAGS.join(', ') + '\n'
  );
  process.exit(2);
}

// Validate --check values if provided
if (opts.check) {
  for (const flag of opts.check) {
    if (!ALL_FLAGS.includes(flag)) {
      process.stderr.write(
        'ns-gate: unknown check "' + flag + '"; valid checks: ' + ALL_FLAGS.join(', ') + '\n'
      );
      process.exit(2);
    }
  }
}

// ---- book root discovery -------------------------------------------------------

const startDir = opts.project ? resolve(opts.project) : process.cwd();

let root;
try {
  ({ root } = findBookRoot(startDir));
} catch (err) {
  if (err.name === 'BibleError') {
    process.stderr.write('ns-gate: ' + err.message + '\n');
    process.exit(2);
  }
  throw err;
}

// ---- explicit chapter must exist ------------------------------------------------

// A --chapter naming no file is an argument error, as in ns-claims, ns-stylometry, ns-scrub and
// ns-overlap. Without this guard the engine saw an empty chapter list, every check reported
// nothing to scan, and the gate exited 0 and wrote a passing report for a chapter it never read,
// even in block mode (2026-11-17 audit, missing-chapter pass). A whole-book run with no
// chapters is unchanged. The Stop hook never passes --chapter, so this cannot reach it.
if (opts.chapter) {
  let chapterPath;
  try {
    chapterPath = join(chaptersDirOf(root), opts.chapter + '.md');
  } catch (err) {
    if (err.name === 'BibleError') {
      process.stderr.write('ns-gate: ' + err.message + '\n');
      process.exit(2);
    }
    throw err;
  }
  if (!existsSync(chapterPath)) {
    process.stderr.write('ns-gate: chapter not found: ' + chapterPath + '\n');
    process.exit(2);
  }
}

// ---- run gate ------------------------------------------------------------------

const { exitCode, report, settingsWarning } = runGate(root, {
  checkSubset: opts.check || null,
  chapterSlug: opts.chapter || null,
  stderrFn: s => process.stderr.write(s),
});

// Settings reader warning (Wave 1 exit Task 2): a corrupt or unreadable per-project settings
// file never breaks the gate (loadSettings fails open), but it must warn loudly on stderr so
// the author knows the file is being ignored rather than honored.
if (settingsWarning) {
  process.stderr.write('ns-gate: settings warning: ' + settingsWarning + '\n');
}

if (!report) {
  process.stderr.write('ns-gate: gate engine failed to produce a report\n');
  process.exit(2);
}

// ---- write report --------------------------------------------------------------

let reportPath;
try {
  ({ reportPath } = writeGateReport(root, report));
} catch (err) {
  process.stderr.write('ns-gate: failed to write gate report: ' + err.message + '\n');
  process.exit(2);
}

// ---- emit to stdout ------------------------------------------------------------

if (opts.json) {
  process.stdout.write(JSON.stringify(report, null, 2) + '\n');
} else {
  // Human-readable summary
  const verdictLine = '[ns-gate] verdict: ' + report.verdict + ' (report: ' + reportPath + ')';
  process.stdout.write(verdictLine + '\n');

  for (const entry of report.checks) {
    const icon = entry.verdict === 'pass' ? 'pass'
      : entry.verdict === 'skip' ? 'skip'
      : entry.verdict === 'warn' ? 'warn'
      : 'BLOCK';
    process.stdout.write('  [' + entry.check + '] ' + icon + ': ' + entry.detail + '\n');
    if (entry.next) {
      process.stdout.write('    next: ' + entry.next + '\n');
    }
  }
}

process.exit(exitCode);
