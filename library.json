{
  "name": "nonfiction-studio",
  "version": "0.1.0",
  "description": "An open-source Claude Code plugin (Cowork support pending verification) that turns Claude into a governed non-fiction book studio: specialist subagents, a plain-Markdown project bible, deterministic quality gates, and publishing compliance support.",
  "standard": "0.12",
  "tier": "universal",
  "agent-targets": ["claude"],
  "components": {
    "agents": [
      "drafting-partner",
      "fact-checker",
      "interviewer",
      "line-editor",
      "research-librarian",
      "structure-architect",
      "thesis-architect",
      "voice-capture"
    ],
    "skills": [
      "nfs-build-apparatus",
      "nfs-capture-voice",
      "nfs-check-chapter",
      "nfs-doctor",
      "nfs-draft",
      "nfs-fact-check",
      "nfs-interview",
      "nfs-new-book",
      "nfs-outline",
      "nfs-quick-scan",
      "nfs-research",
      "nfs-start",
      "nfs-status-dashboard",
      "nfs-tour"
    ],
    "hooks": [
      "SessionStart",
      "PreToolUse",
      "PostToolBatch",
      "PostToolUse",
      "Stop",
      "PreCompact"
    ],
    "clis": [
      "ns-claims",
      "ns-doctor",
      "ns-gate",
      "ns-notes",
      "ns-overlap",
      "ns-scrub",
      "ns-status",
      "ns-statusline",
      "ns-stylometry"
    ]
  }
}
